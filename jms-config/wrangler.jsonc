{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "jms-sub-config",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-12",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "secrets": { "required": ["JMS_SUB_URL", "PROFILE_TOKEN"] },
  "vars": {
    "POLICY_URL": "https://raw.githubusercontent.com/sssstwee/edgetunnel/main/jms-config/clash-base.yaml"
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
