{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "gcp-sub-config",
  "main": "worker-entry.mjs",
  "base_dir": "..",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "rules": [
    {
      "type": "Text",
      "globs": [
        "**/*.yaml"
      ],
      "fallthrough": true
    }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "kv_namespaces": [
    {
      "binding": "GCP_USAGE",
      "id": "d4219d88a69b4d59b658db1a74d4a9e3"
    }
  ],
  "secrets": {
    "required": [
      "GCP_NODES",
      "PROFILE_TOKEN",
      "USAGE_TOKEN"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "routes": [
    {
      "pattern": "gcp.tastedistill.com",
      "custom_domain": true,
      "zone_name": "tastedistill.com"
    }
  ]
}
